{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "APP_URL", "PREVIEW_ORIGIN"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"],
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "AUTH_SECRET",
        "CREDENTIAL_SECRET",
        "AUTH_EMAIL_FROM",
        "SMTP_URL",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "TEXT_PRIMARY_API_KEY",
        "TEXT_PRIMARY_BASE_URL",
        "TEXT_PRIMARY_MODEL",
        "TEXT_FALLBACK_API_KEY",
        "TEXT_FALLBACK_BASE_URL",
        "TEXT_FALLBACK_MODEL",
        "IMAGE_API_KEY",
        "IMAGE_BASE_URL",
        "IMAGE_MODEL",
        "VIDEO_API_KEY",
        "VIDEO_BASE_URL",
        "VIDEO_MODEL",
        "SPEECH_API_KEY",
        "SPEECH_BASE_URL",
        "SPEECH_TTS_MODEL",
        "SPEECH_STT_MODEL",
        "EMBEDDING_API_KEY",
        "EMBEDDING_BASE_URL",
        "EMBEDDING_MODEL",
        "PAYMENT_API_KEY",
        "PAYMENT_WEBHOOK_SECRET"
      ]
    },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": {},
    "test": { "dependsOn": ["^build"] },
    "dev": { "cache": false, "persistent": true }
  }
}
