# ─────────────────────────────────────────────────────────────
# YARUB ONE — environment template
# NEVER commit a filled .env. NEVER add a secret to a NEXT_PUBLIC_* var.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
APP_URL=http://localhost:3000
PREVIEW_ORIGIN=http://localhost:3001   # sandboxed origin for generated code

# --- Data ---
DATABASE_URL=postgresql://yarub:yarub@localhost:5432/yarub_one
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible; MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=yarub-one
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Auth ---
AUTH_SECRET=
# Encrypts provider credentials stored in the database. Rotate independently.
CREDENTIAL_SECRET=
AUTH_EMAIL_FROM=no-reply@example.com
SMTP_URL=

# --- Text providers (Phase 1) ---
# Leave blank to keep the capability in NOT_CONFIGURED state.
# The app must never fake a result for an unconfigured provider.
TEXT_PRIMARY_API_KEY=
TEXT_PRIMARY_BASE_URL=
TEXT_PRIMARY_MODEL=

TEXT_FALLBACK_API_KEY=
TEXT_FALLBACK_BASE_URL=
TEXT_FALLBACK_MODEL=

# --- Later phases (declared now, unused until enabled) ---
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=

VIDEO_API_KEY=
VIDEO_BASE_URL=
VIDEO_MODEL=

SPEECH_API_KEY=
SPEECH_BASE_URL=
SPEECH_TTS_MODEL=
SPEECH_STT_MODEL=

EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# --- Quotas (video is the expensive one) ---
# --- Payments (optional; absent = subscriptions report NEEDS_CREDENTIAL) ---
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CHECKOUT_URL=

QUOTA_JOBS_PER_DAY=200
QUOTA_IMAGES_PER_DAY=100
QUOTA_VIDEO_SECONDS_PER_DAY=60

# --- Limits ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_PROMPT_CHARS=24000
MAX_UPLOAD_BYTES=26214400
