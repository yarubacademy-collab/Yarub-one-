userId    String
  credits   Decimal   @db.Decimal(14, 4)
  reason    String
  source    String    @default("manual")
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Plans are data, not code.
///
/// Prices, quotas and video duration ceilings all live here so the owner can
/// change them from the admin area without a deploy. The application reads
/// limits from this table; the constants in @yarub/billing only seed it.
model Plan {
  id       String  @id @default(cuid())
  code     String  @unique // free | premium_monthly | premium_yearly
  name     String
  active   Boolean @default(true)

  priceMinor Int    @default(0)
  currency   String @default("USD")
  /// Optional promotional price; when set and unexpired it overrides priceMinor.
  promoPriceMinor Int?
  promoEndsAt     DateTime?
  /// Optional one-time price for an account's first-ever purchase, in this plan's
  /// own currency. Every renewal after that is at the regular price. Null means
  /// no such offer.
  introPriceMinor Int?

  intervalDays Int @default(30)

  imageQuota      Int @default(2)
  videoQuota      Int @default(2)
  maxVideoSeconds Int @default(10)
  websiteQuota    Int @default(1)
  gameQuota       Int @default(1)
  documentQuota   Int @default(5)

  features Json?

  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  planId    String
  status    SubscriptionStatus @default(active)
  startedAt DateTime           @default(now())
  expiresAt DateTime?
  graceDays Int                @default(3)
  /// Set when the user cancels; access continues until expiresAt.
  cancelledAt DateTime?
  /// Opaque reference from whichever payment provider is connected later.
  externalRef String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId, status])
}

/// Append-only billing history. Payment provider webhooks write here; nothing
/// mutates a past event, so subscription history is always reconstructable.
model BillingEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String // subscription.created | renewed | cancelled | payment.failed
  planCode  String?
  amountMinor Int?
  currency  String?
  /// Provider name and reference; null while no provider is connected.
  provider    String?
  externalRef String?
  payload   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
