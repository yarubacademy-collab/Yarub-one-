// YARUB ONE — data model
// Every artifact belongs to a Project. There are no orphan outputs.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  ar
  ur
  en
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  active
  grace
  expired
  cancelled
}

enum JobStatus {
  planning
  queued
  running
  succeeded
  failed
  cancelled
}

enum StepStatus {
  pending
  running
  succeeded
  failed
  skipped
  not_configured
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  emailVerified DateTime?
  locale        Locale    @default(ar)
  // Role-based access control. No personal identity is hard-coded anywhere;
  // the first admin is promoted by the operator via a seed script.
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())

  projects     Project[]
  usageLogs     UsageLog[]
  auditLogs     AuditLog[]
  creditGrants  CreditGrant[]
  subscriptions Subscription[]
  billingEvents BillingEvent[]
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  title     String
  domain    String
  language  Locale
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  jobs          Job[]
  artifacts     Artifact[]
  assets        Asset[]

  @@index([userId, updatedAt])
}

model Conversation {
  id        String    @id @default(cuid())
  projectId String
  title     String
  createdAt DateTime  @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([projectId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String // system | user | assistant
  content        String   @db.Text
  tokens         Int      @default(0)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Job {
  id        String    @id @default(cuid())
  projectId String
  type      String
  status    JobStatus @default(planning)
  planJson  Json?
  progress  Int       @default(0)
  errorCode String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps   JobStep[]

  @@index([projectId, createdAt])
  @@index([status])
}

// Checkpointing lives here: a failed step 6 never re-runs steps 1-5.
model JobStep {
  id         String     @id @default(cuid())
  jobId      String
  stepKey    String
  capability String
  status     StepStatus @default(pending)
  providerId String?
  outputRef  String?
  errorCode  String?
  attempts   Int        @default(0)
  startedAt  DateTime?
  finishedAt DateTime?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, stepKey])
  @@index([jobId])
}

model Artifact {
  id               String   @id @default(cuid())
  projectId        String
  type             String
  title            String
  currentVersionId String?
  createdAt        DateTime @default(now())

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions ArtifactVersion[]

  @@index([projectId])
}

model ArtifactVersion {
  id         String   @id @default(cuid())
  artifactId String
  version    Int
  storageKey String
  meta       Json?
  createdAt  DateTime @default(now())

  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([artifactId, version])
}

model Asset {
  id         String   @id @default(cuid())
  projectId  String
  kind       String // image | video | audio | file
  storageKey String
  mime       String
  bytes      Int
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProviderConfig {
  id         String   @id @default(cuid())
  capability String
  providerId String
  enabled    Boolean  @default(true)
  tier       String

  // Credentials set through Settings. Stored AES-256-GCM encrypted; the
  // plaintext never leaves the server and is never returned to a client.
  baseUrl          String?
  model            String?
  // Speech providers need two models. `model` carries TTS; this carries STT.
  sttModel         String?
  encryptedApiKey  String?
  keyHint          String? // masked form, safe to display
  costWeight       Int      @default(10)

  updatedAt  DateTime @updatedAt

  @@unique([capability, providerId])
}

model UsageLog {
  id            String   @id @default(cuid())
  userId        String
  jobId         String?
  capability    String
  providerId    String
  units         Int
  costEstimate  Decimal  @db.Decimal(12, 6)
  at            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
}

model AuditLog {
  id     String   @id @default(cuid())
  userId String?
  action String
  target String?
  ip     String?
  at     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, at])
}

/// Credit grants.
///
/// Debits are derived from UsageLog rather than duplicated here, so the ledger
/// cannot disagree with what was actually spent. A grant is append-only; a
/// correction is a negative grant, never an edit.
model CreditGrant {
  id        String    @id @default(cuid())
  userId    String
  credits   Decimal   @db.Decimal(14, 4)
  reason    String
  source    String    @default("manual")
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Plans are data, not code.
///
/// Prices, quotas and video duration ceilings all live here so the owner can
/// change them from the admin area without a deploy. The application reads
/// limits from this table; the constants in @yarub/billing only seed it.
/// General facts about the academy — intro, departments, the yarub-library
/// reference collection, policies. Always sent to the chat model in full,
/// unlike Course rows, which are matched and sent only when relevant. A
/// singleton: one row, id "main", edited in place from the admin console.
model AcademyInfo {
  id        String   @id @default("main")
  content   String   @db.Text
  updatedAt DateTime @updatedAt
}

/// One course offered by the academy. Kept as data, not code, for the same
/// reason plans are: so the owner can add, retire or correct a course from
/// the admin console with no deploy. `price` and `schedule` are free text —
/// prices are quoted in whatever currency the owner states (SAR, OMR, ...)
/// and are never auto-converted, since a stored rate would drift from reality.
/// `imageUrl` is any publicly reachable link (a GitHub-hosted image works
/// well, as the app's own icon already demonstrates) — this app never hosts
/// the file itself.
model Course {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  price       String
  schedule    String?
  /// The real moment the course starts. `schedule` stays free text for a
  /// human to read ("Mon & Wed, 7pm Mecca time"); this is what a reminder job
  /// can actually schedule against. Optional, so a course with no fixed start
  /// time is still just a course — nothing breaks for it, it is simply never
  /// picked up by the reminder step.
  startsAt    DateTime?
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Plan {
  id       String  @id @default(cuid())
  code     String  @unique // free | premium_monthly | premium_yearly
  name     String
  active   Boolean @default(true)

  priceMinor Int    @default(0)
  currency   String @default("USD")
  /// Optional promotional price; when set and unexpired it overrides priceMinor.
  promoPriceMinor Int?
  promoEndsAt     DateTime?
  /// Optional one-time price for an account's first-ever purchase, in this plan's
  /// own currency. Every renewal after that is at the regular price. Null means
  /// no such offer.
  introPriceMinor Int?

  intervalDays Int @default(30)

  imageQuota      Int @default(2)
  videoQuota      Int @default(2)
  maxVideoSeconds Int @default(10)
  websiteQuota    Int @default(1)
  gameQuota       Int @default(1)
  documentQuota   Int @default(5)

  features Json?

  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  planId    String
  status    SubscriptionStatus @default(active)
  startedAt DateTime           @default(now())
  expiresAt DateTime?
  graceDays Int                @default(3)
  /// Set when the user cancels; access continues until expiresAt.
  cancelledAt DateTime?
  /// Opaque reference from whichever payment provider is connected later.
  externalRef String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId, status])
}

/// Append-only billing history. Payment provider webhooks write here; nothing
/// mutates a past event, so subscription history is always reconstructable.
model BillingEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String // subscription.created | renewed | cancelled | payment.failed
  planCode  String?
  amountMinor Int?
  currency  String?
  /// Provider name and reference; null while no provider is connected.
  provider    String?
  externalRef String?
  payload   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
