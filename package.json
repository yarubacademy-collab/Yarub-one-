{
  "name": "yarub-one",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "turbo run lint",
    "test": "vitest run",
    "infra:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.dev.yml down",
    "db:migrate": "pnpm --filter @yarub/db exec prisma migrate dev",
    "db:studio": "pnpm --filter @yarub/db exec prisma studio",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:watch": "vitest",
    "worker:dev": "pnpm --filter @yarub/worker dev",
    "preview:dev": "pnpm --filter @yarub/preview dev",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm check:boundaries && pnpm test",
    "db:seed": "pnpm --filter @yarub/db seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.20.1",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9",
    "zod": "^3.23.8"
  }
}
